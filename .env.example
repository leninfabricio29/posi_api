# Copie este archivo a .env y complete los valores. Nunca suba .env al repositorio.
DATABASE_URL="postgresql://USUARIO:CONTRASENA@localhost:5432/restaurant_pos"
JWT_SECRET="cambie-esto-por-un-secreto-largo-aleatorio"
JWT_REFRESH_SECRET="cambie-esto-por-otro-secreto-largo-aleatorio"
PORT=4010
NODE_ENV=development
# Orígenes permitidos (coma-separado) para CORS y Socket.IO
CORS_ORIGINS=http://localhost:3000
# Producción: CORS_ORIGINS=https://pos.softkilla.es
# Proxies de confianza para leer la IP real (X-Forwarded-For). Por defecto: red local y Docker.
# TRUST_PROXY=loopback, linklocal, uniquelocal
# Opcional: admin inicial creado por `npx prisma db seed`
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
